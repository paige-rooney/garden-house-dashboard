NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# development | preview | production
APP_ENV=development
# First person allowed to become owner. Required in production.
OWNER_BOOTSTRAP_EMAIL=
# 64-character hex key used to encrypt Google tokens. Never commit the real value.
INTEGRATION_ENCRYPTION_KEY=
STUDIO_TIMEZONE=America/Chicago

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe stays in test mode until live mode is explicitly approved.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

RESEND_API_KEY=
RESEND_FROM=hello@gardenhouserecordingstudios.com
RESEND_CONTACT_TO=hello@gardenhouserecordingstudios.com
RESEND_EVENTS_LIST=events@gardenhouserecordingstudios.com
# In development/preview, all outgoing email is redirected here when set.
EMAIL_SAFE_RECIPIENT=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gh-studio-assets
R2_PUBLIC_BASE_URL=

# studio (built-in signing page) or dropbox_sign (requires paid API key)
CONTRACTS_PROVIDER=studio
DROPBOX_SIGN_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/oauth/callback

ALLOW_DEBUG_ENDPOINTS=false
SENTRY_DSN=
